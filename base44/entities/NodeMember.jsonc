{
  "name": "NodeMember",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "description": "Reference to Node"
    },
    "userId": {
      "type": "string",
      "description": "Reference to User"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "client",
        "member"
      ],
      "default": "member",
      "description": "Role in the node"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes about this member"
    }
  },
  "required": [
    "nodeId",
    "userId",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}