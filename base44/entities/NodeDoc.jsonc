{
  "name": "NodeDoc",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "description": "Reference to Node"
    },
    "key": {
      "type": "string",
      "enum": [
        "agreement",
        "sow",
        "oosw",
        "siteCode"
      ],
      "description": "Document type identifier"
    },
    "content": {
      "type": "string",
      "description": "Document content"
    },
    "updatedBy": {
      "type": "string",
      "description": "User ID of last updater"
    }
  },
  "required": [
    "nodeId",
    "key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}",
                  "data.role": {
                    "$in": [
                      "owner",
                      "member"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}"
                }
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}",
                  "data.role": {
                    "$in": [
                      "owner",
                      "member"
                    ]
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}",
                  "data.role": "owner"
                }
              }
            ]
          }
        }
      ]
    }
  }
}