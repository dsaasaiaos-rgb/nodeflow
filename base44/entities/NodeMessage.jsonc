{
  "name": "NodeMessage",
  "type": "object",
  "properties": {
    "nodeId": {
      "type": "string",
      "description": "Reference to Node"
    },
    "userId": {
      "type": "string",
      "description": "Reference to User who sent message"
    },
    "userName": {
      "type": "string",
      "description": "Name of user at time of sending"
    },
    "body": {
      "type": "string",
      "description": "Message content"
    }
  },
  "required": [
    "nodeId",
    "userId",
    "userName",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.userId": "{{user.id}}",
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}"
                }
              }
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}"
                }
              }
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.userId": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.nodeId": {
            "$in": [
              {
                "from_entity": "NodeMember",
                "field": "data.nodeId",
                "filter": {
                  "data.userId": "{{user.id}}",
                  "data.role": "owner"
                }
              }
            ]
          }
        },
        {
          "data.userId": "{{user.id}}"
        }
      ]
    }
  }
}