{
  "name": "ChatParticipant",
  "type": "object",
  "properties": {
    "conversationId": {
      "type": "string",
      "description": "Reference to ChatConversation"
    },
    "userId": {
      "type": "string",
      "description": "Reference to User"
    },
    "hasRead": {
      "type": "boolean",
      "default": true,
      "description": "Whether user has read the latest messages"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or notes about this participant"
    }
  },
  "required": [
    "conversationId",
    "userId"
  ]
}